# Discord bot token
DISCORD_TOKEN=

# Comma-separated list of allowed command contexts:
#   GUILD_ID:TEXT_CHANNEL_ID,GUILD_ID:TEXT_CHANNEL_ID
ALLOWED_COMMAND_CONTEXTS=

# Where downloaded audio is cached (relative to process.cwd)
CACHE_DIR=./cache

# Binaries (must be available on PATH, or provide absolute paths)
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# If the queue is empty and idle, disconnect after N seconds
IDLE_DISCONNECT_SEC=60

# debug | info | warn | error
LOG_LEVEL=info

